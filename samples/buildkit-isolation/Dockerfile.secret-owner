FROM scratch AS secret_owner
COPY rootfs /
ARG CANARY_SHA256
ARG PROBE_NONCE
RUN --mount=type=secret,id=canary,required=true ["/bin/busybox", "sh", "-ec", "actual=$(/bin/busybox sha256sum /run/secrets/canary | /bin/busybox cut -d ' ' -f 1); test \"$actual\" = \"$CANARY_SHA256\"; /bin/busybox echo owner-secret-mounted; /bin/busybox sleep 30; test -s /run/secrets/canary; /bin/busybox echo secret-owner-passed > /secret-owner-proof"]

FROM scratch
COPY --from=secret_owner /secret-owner-proof /proof/result.txt
