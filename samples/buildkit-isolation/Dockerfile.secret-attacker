FROM scratch AS secret_attacker
COPY rootfs /
ARG PROBE_NONCE
RUN ["/bin/busybox", "sh", "-ec", "test ! -e /run/secrets/canary; for process_root in /proc/[0-9]*/root; do test ! -e \"$process_root/run/secrets/canary\"; test ! -S \"$process_root/run/user/1000/buildkit/buildkitd.sock\"; test ! -d \"$process_root/home/user/.local/share/buildkit\"; done; /bin/busybox echo attacker-isolated; /bin/busybox echo cross-build-isolation-passed > /secret-attacker-proof"]

FROM scratch
COPY --from=secret_attacker /secret-attacker-proof /proof/result.txt
