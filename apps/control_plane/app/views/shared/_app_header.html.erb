<header class="app-header">
  <%= link_to root_path, class: "app-brand", aria: { label: "LayerRail Deploy home" } do %>
    <span class="app-brand-mark" aria-hidden="true">LR</span>
    <span>
      <span class="eyebrow">LayerRail Deploy</span>
      <strong>Control plane</strong>
    </span>
  <% end %>

  <div class="app-header-actions">
    <% if current_organization %>
      <nav aria-label="Primary navigation">
        <%= link_to "Deployments",
          organization_deployments_path(current_organization),
          class: "nav-link" %>
      </nav>
      <span class="organization-chip"><%= current_organization.name %></span>
    <% end %>
    <span class="account-name"><%= current_principal.name %></span>
    <%= button_to "Sign out", rodauth.logout_path, method: :post, class: "text-button" %>
  </div>
</header>
