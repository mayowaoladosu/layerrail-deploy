<% content_for :title, "Sign out" %>

<main id="main-content" class="flex flex-col items-center justify-center h-[calc(100vh-65px)]">
  <div class="w-full max-w-xs space-y-6 text-center">
    <h1 class="h2">Sign out of LayerRail Deploy?</h1>
    <p class="text-muted-foreground">The current browser session will be revoked immediately.</p>

    <%= form_with url: rodauth.logout_path,
      method: :post,
      class: "form grid gap-4",
      data: {
        turbo: false,
        controller: "auth-submit",
        action: "submit->auth-submit#start"
      } do |form| %>
      <%= form.submit "Sign out",
        class: "btn w-full",
        data: { auth_submit_target: "button" } %>
    <% end %>

    <%= link_to "Return to LayerRail Deploy", root_path, class: "font-medium underline underline-offset-4" %>
  </div>
</main>
