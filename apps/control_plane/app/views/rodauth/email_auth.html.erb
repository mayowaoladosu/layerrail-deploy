<% content_for :title, "Finish signing in" %>

<main id="main-content" class="flex flex-col items-center justify-center h-[calc(100vh-65px)]">
  <div class="w-full max-w-xs space-y-6 text-center">
    <h1 class="h2">Finish signing in</h1>
    <p class="text-muted-foreground">Confirm this browser to use the secure, one-time link.</p>

    <%= form_with url: rodauth.email_auth_path,
      method: :post,
      class: "form grid gap-4",
      data: {
        turbo: false,
        controller: "auth-submit",
        action: "submit->auth-submit#start"
      } do |form| %>
      <%= form.submit "Continue with email",
        class: "btn w-full",
        data: { auth_submit_target: "button" } %>
      <span class="[&>svg]:size-4 [&>svg]:animate-spin" hidden data-auth-submit-target="spinner" aria-hidden="true"><%= legacy_icon("loader") %></span>
    <% end %>
  </div>
</main>
