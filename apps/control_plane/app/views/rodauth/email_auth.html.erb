<% content_for :title, "Finish signing in" %>

<main id="main-content" class="legacy-auth-main">
  <div class="legacy-auth-stack legacy-auth-message">
    <h1>Finish signing in</h1>
    <p>Confirm this browser to use the secure, one-time link.</p>

    <%= form_with url: rodauth.email_auth_path,
      method: :post,
      class: "legacy-auth-form",
      data: {
        turbo: false,
        controller: "auth-submit",
        action: "submit->auth-submit#start"
      } do |form| %>
      <%= form.submit "Continue with email",
        class: "legacy-auth-button legacy-auth-button-primary",
        data: { auth_submit_target: "button" } %>
      <span class="legacy-auth-spinner legacy-auth-spinner-centered" hidden data-auth-submit-target="spinner" aria-hidden="true"></span>
    <% end %>
  </div>
</main>
