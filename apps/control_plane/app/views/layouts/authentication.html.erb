<!doctype html>
<html>
  <head>
    <meta charset="utf-8">
    <title><%= content_for(:title) || [ @page_title, "LayerRail Deploy" ].compact.join(" · ") %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <script>
      (() => {
        try {
          const stored = localStorage.getItem("themeMode")
          if (stored ? stored === "dark" : matchMedia("(prefers-color-scheme: dark)").matches) {
            document.documentElement.classList.add("dark")
          }
        } catch (_) {}
      })()
    </script>

    <link rel="icon" type="image/svg+xml" href="<%= legacy_asset_path("favicon.svg") %>">
    <%= stylesheet_link_tag legacy_asset_path("styles.css"), data: { turbo_track: "reload" } %>
    <script src="<%= legacy_asset_path("basecoat.min.js") %>" defer></script>
    <script src="<%= legacy_asset_path("alpine.min.js") %>" defer></script>
    <script src="<%= legacy_asset_path("htmx.min.js") %>" defer></script>
    <%= javascript_importmap_tags %>
  </head>

  <body class="relative h-full text-sm min-h-screen">
    <a class="sr-only focus:not-sr-only" href="#main-content">Skip to main content</a>
    <%= render "shared/legacy_header" %>

    <%= yield %>
    <%= render "shared/flash_toasts" %>
  </body>
</html>
