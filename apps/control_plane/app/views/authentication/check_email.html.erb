<% content_for :title, "Check your email · LayerRail Deploy" %>

<main id="main-content" class="auth-shell auth-shell-centered">
  <section class="auth-panel" aria-labelledby="check-email-heading">
    <div class="auth-card">
      <div class="success-mark" aria-hidden="true">✓</div>
      <p class="eyebrow">Link requested</p>
      <h1 id="check-email-heading">Check your email</h1>
      <p>If the address can sign in, a secure link is on its way. It expires after 15 minutes.</p>

      <% if @development_verification_url %>
        <div class="development-link">
          <strong>Development shortcut</strong>
          <%= link_to "Open the one-time sign-in link", @development_verification_url %>
        </div>
      <% end %>

      <%= link_to "Use a different email", auth_login_path, class: "secondary-link" %>
    </div>
  </section>
</main>
