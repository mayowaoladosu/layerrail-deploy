<% content_for :title, "Sign in · LayerRail Deploy" %>

<main id="main-content" class="auth-shell">
  <section class="auth-brand" aria-labelledby="brand-heading">
    <div class="brand-mark" aria-hidden="true">LR</div>
    <p class="eyebrow">LayerRail Deploy</p>
    <h1 id="brand-heading">Ship code without surrendering control.</h1>
    <p class="brand-copy">A durable control plane for builds, revisions, environments, and instant rollback.</p>
    <ul class="auth-points" aria-label="Platform benefits">
      <li>Immutable deployment history</li>
      <li>Readiness-gated promotion</li>
      <li>One-click rollback without rebuilds</li>
    </ul>
  </section>

  <section class="auth-panel" aria-labelledby="login-heading">
    <div class="auth-card">
      <p class="eyebrow">Passwordless access</p>
      <h2 id="login-heading">Sign in to your control plane</h2>
      <p>Enter your work email. A secure, one-time link will arrive shortly.</p>

      <% if @error %>
        <div class="form-alert" role="alert"><%= @error %></div>
      <% end %>

      <%= form_with url: auth_login_path, method: :post, class: "auth-form" do |form| %>
        <%= form.label :email, "Email address" %>
        <%= form.email_field :email,
          required: true,
          autofocus: true,
          autocomplete: "email",
          maxlength: 320,
          placeholder: "you@company.com" %>
        <%= form.submit "Send secure sign-in link" %>
      <% end %>

      <p class="form-note">Links expire after 15 minutes and work only once.</p>
    </div>
  </section>
</main>
