<% if @can_rollback %>
  <%= button_to rollback_project_deployment_path(current_organization.slug, @project.slug, @deployment),
    method: :post,
    params: { revision_id: @alias_record.previous_revision_id, expected_lock_version: @alias_record.lock_version },
    role: "menuitem",
    form: { data: { turbo_confirm: "Rollback to the previous healthy revision without rebuilding?" } } do %>
    <%= legacy_icon("undo-2") %>Instant rollback
  <% end %>
<% end %>

<% if @can_promote %>
  <%= button_to promote_project_deployment_path(current_organization.slug, @project.slug, @deployment),
    method: :post,
    role: "menuitem",
    form: { data: { turbo_confirm: "Move this environment URL to the ready revision?" } } do %>
    <%= legacy_icon("chevrons-up") %>Promote
  <% end %>
<% end %>

<% if @can_redeploy %>
  <%= button_to redeploy_project_deployment_path(current_organization.slug, @project.slug, @deployment),
    method: :post,
    params: { operation_id: SecureRandom.uuid_v7 },
    role: "menuitem",
    form: { data: { turbo_confirm: "Redeploy this immutable source with the latest configuration?" } } do %>
    <%= legacy_icon("redo-2") %>Redeploy
  <% end %>
<% end %>

<% unless @can_manage %>
  <span role="menuitem" class="text-muted-foreground">Members can inspect this deployment.</span>
<% end %>
