<section id="deployment_live"
  class="w-full rounded-lg border group"
  aria-busy="false"
  data-controller="live-status<%= " log-filter" if @log_feed.entries.any? %>"
  data-live-status-url-value="<%= live_project_deployment_path(current_organization.slug, @project.slug, @deployment, format: :turbo_stream) %>"
  data-live-status-version-value="<%= @live_version %>"
  data-live-status-active-value="<%= !@deployment.terminal? %>"
  data-log-filter-storage-key-value="deployment-log-filter:<%= @deployment.id %>">
  <div class="alert-destructive m-4" role="status" data-live-status-target="error" hidden>Live updates paused. Persisted deployment state remains available.</div>
  <header class="px-4 h-10 w-full flex items-center gap-x-2">
    Logs
    <span class="text-muted-foreground text-xs ml-auto">
      <% if @provider_logs.status == :ok && @provider_logs.retained %>Retained runtime logs<% elsif @provider_logs.status == :ok %>Runtime connected<% else %>Persisted events only<% end %>
    </span>
    <%= link_to legacy_icon("logs"), project_deployment_logs_path(current_organization.slug, @project.slug, @deployment), class: "btn-sm-icon-ghost", data: { tooltip: "Download logs", turbo: false }, aria: { label: "Download logs" } %>
  </header>

  <% if @log_feed.entries.any? %>
    <div class="form grid sm:grid-cols-[1fr_12rem] gap-3 border-t p-3" role="search" aria-label="Filter deployment logs">
      <label class="grid gap-1"><span class="text-xs text-muted-foreground">Search logs</span><input type="search" placeholder="Filter visible messages" autocomplete="off" data-log-filter-target="query" data-action="input->log-filter#filter"></label>
      <label class="grid gap-1"><span class="text-xs text-muted-foreground">Stream</span><select data-log-filter-target="stream" data-action="change->log-filter#filter"><option value="all">All streams</option><option value="build">Build</option><option value="runtime">Runtime</option><option value="system">System</option></select></label>
    </div>
  <% end %>

  <% if @provider_logs.status == :unavailable %>
    <div class="alert m-3" role="status"><%= legacy_icon("triangle-alert") %><section>Runtime output is temporarily unavailable. Persisted build and status events remain complete, and live updates will retry.</section></div>
  <% elsif @provider_logs.status == :not_found && @deployment.terminal? %>
    <div class="text-muted-foreground px-4 py-2 border-t" role="status">The runtime is no longer active. Persisted build and status events remain available.</div>
  <% elsif @provider_logs.retained %>
    <div class="text-muted-foreground px-4 py-2 border-t" role="status">The runtime has stopped. Its latest redacted output is retained with the persisted deployment events below.</div>
  <% end %>
  <% if @log_feed.truncated %><p class="text-muted-foreground px-4 py-2 border-t">Showing the latest 200 runtime lines plus persisted deployment events.</p><% end %>

  <div id="deployment-logs" class="overflow-y-auto h-[500px] relative p-2 border-t scrollbar-thin scrollbar">
    <% if @log_feed.entries.any? %>
      <ol class="font-mono text-[13px] leading-5" role="log" aria-live="off" aria-label="Deployment log entries"><% @log_feed.entries.each do |entry| %><li class="grid grid-cols-[5rem_4rem_1fr] gap-x-2 hover:bg-muted/50 px-2 py-0.5" data-log-filter-target="entry" data-stream="<%= entry.stream %>" data-message="<%= entry.message.downcase %>"><time class="text-muted-foreground" datetime="<%= entry.timestamp.utc.iso8601(6) %>"><%= entry.timestamp.utc.strftime("%H:%M:%S") %></time><span class="text-muted-foreground uppercase text-xs"><%= entry.stream %></span><code class="whitespace-pre-wrap break-all"><%= entry.message %></code></li><% end %></ol>
      <p class="absolute inset-0 items-center justify-center text-muted-foreground" data-log-filter-target="empty" hidden>No visible log entries match this filter.</p>
    <% else %>
      <div class="absolute inset-0 flex items-center justify-center text-muted-foreground"><div class="flex items-center gap-x-2 [&>svg]:size-4"><%= legacy_icon(@deployment.terminal? ? "ban" : "loader") %><%= @deployment.terminal? ? "No logs found" : "Waiting for logs" %></div></div>
    <% end %>
  </div>
</section>
